---
layout: default
---

<div class="post home-page">
  <header class="post-header">
    <div class="home-hero">
      <div class="home-hero-copy">
        <p class="home-eyebrow">NEUROBIOLOGY · PERCEPTION · NATURAL BEHAVIOR</p>
        <h1 class="post-title">
      {% if site.title == 'blank' %}
        {{ site.first_name }} {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
        </h1>
        <p class="desc">{{ page.subtitle }}</p>
        <div class="home-actions">
          <a class="home-action home-icon-action" href="mailto:brian_xu@hms.harvard.edu" aria-label="Email Brian Xu" title="Email">
            <i class="fa-solid fa-envelope" aria-hidden="true"></i>
          </a>
          <a class="home-action home-icon-action" href="{{ '/cv/' | relative_url }}" aria-label="Curriculum vitae" title="CV">CV</a>
          <a class="home-action home-icon-action" href="https://www.linkedin.com/in/zhexinxu" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile" title="LinkedIn">
            <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
          </a>
          <a class="home-action home-icon-action" href="https://scholar.google.com/citations?user=632LW50AAAAJ&amp;hl=en" target="_blank" rel="noopener noreferrer" aria-label="Google Scholar profile" title="Google Scholar">
            <i class="ai ai-google-scholar" aria-hidden="true"></i>
          </a>
        </div>
      </div>
      <div class="home-profile">
        {% if page.profile and page.profile.image %}
          <img
            src="{{ '/assets/img/' | append: page.profile.image | relative_url }}"
            alt="{{ site.first_name }} {{ site.last_name }}"
            class="img-fluid z-depth-1 rounded-circle"
          >
        {% endif %}
      </div>
    </div>
  </header>

  <article class="home-sections">
    <div class="home-intro">
    <div class="clearfix">{{ content }}</div>
    </div>

    {% include home_research.liquid %}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <br>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <section class="home-publications">
        <h2>
          <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected publications</a>
        </h2>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
